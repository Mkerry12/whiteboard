# Copy to apps/web/.env to override. Defaults match the in-browser mock
# and the dev sync server (`pnpm --filter @whiteboard/web sync-server`).
# Real backend (see the root README, "Run against the real backend"):
#   VITE_USE_MOCK=false
#   VITE_API_URL=http://localhost:3000
#   VITE_SYNC_URL=ws://localhost:3000/collaboration
VITE_USE_MOCK=true
VITE_SYNC_URL=ws://localhost:1234
VITE_API_URL=http://localhost:3000
