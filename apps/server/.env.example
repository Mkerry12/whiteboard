# Names match the repo root .env.example and docker-compose.dev.yml.
# Copy this file to apps/server/.env, or put the same variables in the root .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/whiteboard
REDIS_URL=redis://localhost:6379
# The root placeholder "replace-me" is too short. Use at least 16 characters.
JWT_SECRET=local-dev-secret-change-me
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
# Optional. Unique per process so two demo instances do not collide in Redis.
# INSTANCE_ID=server-a
# REDIS_PREFIX=whiteboard
